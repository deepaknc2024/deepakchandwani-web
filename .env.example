# ============================================================
# Environment Variables for web.deepakchandwani.com
# Copy this file to .env and fill in the values
# ============================================================

NODE_ENV=production
PORT=3001

# ── PostgreSQL Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dcweb
DB_USER=dcweb
DB_PASSWORD=            # Generated by setup.sh or set manually

# ── API Keys ─────────────────────────────────────────────────

# Guardian News API (powers the live news widget on landing page)
# "test" works for free tier (8 requests/sec, no key needed)
GUARDIAN_API_KEY=test

# OpenAI API Key (powers the BSE Meeting voice chatbot)
# Uses the Realtime API with gpt-4o-mini for voice conversations
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter API Key (powers transcript summarization)
# Free models used first (OpenAI GPT-OSS 120B), Gemini Flash as fallback
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Sarvam AI API Key (Indian language TTS fallback)
# Used as fallback when Edge TTS fails for Indian languages
# Get one at: https://www.sarvam.ai
SARVAM_API_KEY=

# ── Auth & Email ─────────────────────────────────────────────

# JWT secret for password-protected page tokens
# Auto-generated by setup.sh or set any random 32+ char string
JWT_SECRET=

# Session secret for user authentication (random 32+ char string)
SESSION_SECRET=

# Google OAuth 2.0 (for Google Sign-In button)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: https://web.deepakchandwani.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://web.deepakchandwani.com/api/auth/google/callback

# Email for contact form notifications
CONTACT_EMAIL=deepakchandwani@yahoo.com
